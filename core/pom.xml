<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fun.fengwk.opencli-hub</groupId>
        <artifactId>opencli-hub-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>opencli-hub-core</artifactId>

    <dependencies>
        <dependency>
            <groupId>fun.fengwk.opencli-hub</groupId>
            <artifactId>opencli-hub-share</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.convention4j</groupId>
            <artifactId>convention4j-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.auto-mapper</groupId>
            <artifactId>auto-mapper-annotation</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.auto-mapper</groupId>
            <artifactId>auto-mapper-processor</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- H2 is a test-only database; production variants are selected by Maven profile. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.convention4j</groupId>
            <artifactId>convention4j-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Everything except auto-mapper.config is copied verbatim. -->
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>auto-mapper.config</exclude>
                </excludes>
            </resource>
            <!-- Only the AutoMapper dbType line is Maven-filtered; the rest of the file is
                 identical across variants. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>auto-mapper.config</include>
                </includes>
            </resource>
            <!-- The active profile's DDL is copied to the classpath root as schema-database.sql
                 so web's spring.sql.init.schema-locations stays variant-independent. -->
            <resource>
                <directory>src/main/database/${db.variant}</directory>
                <includes>
                    <include>schema-database.sql</include>
                </includes>
            </resource>
        </resources>
    </build>

    <!-- Exactly one production JDBC driver per clean build, matching the active variant. -->
    <profiles>
        <profile>
            <id>postgresql</id>
            <dependencies>
                <dependency>
                    <groupId>org.postgresql</groupId>
                    <artifactId>postgresql</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>mysql</id>
            <dependencies>
                <dependency>
                    <groupId>com.mysql</groupId>
                    <artifactId>mysql-connector-j</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>sqlite</id>
            <dependencies>
                <dependency>
                    <groupId>org.xerial</groupId>
                    <artifactId>sqlite-jdbc</artifactId>
                    <!-- Explicitly pinned stable release, verified resolvable on Maven Central
                         (latest 3.49.1.0) and identical to the Spring Boot 3.5.16 managed version. -->
                    <version>3.49.1.0</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
