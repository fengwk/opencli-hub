# opencli-artifact.lock.env
#
# Single tracked pin for the OpenCLI CLI + Browser Bridge extension artifacts
# consumed by Docker/CI/local image builds. Edit this file (and only this file)
# to switch the default Hub image from the official baseline to a published fork
# Release. Do not point the committed default at unpublished local assets.
#
# Pair-upgrade rule: CLI and extension must be upgraded together from the same
# OpenCLI release and every remote artifact must carry a matching SHA256.

OPENCLI_PACKAGE=@jackwener/opencli
OPENCLI_VERSION=1.8.7-fengwk.12
OPENCLI_CLI_URL=https://github.com/fengwk/OpenCLI/releases/download/fork-v1.8.7-fengwk.12/jackwener-opencli-1.8.7-fengwk.12.tgz
OPENCLI_CLI_SHA256=3b90e27352e1296e1951665a76c27a3631d2be6ef02a8fd8b282322054a5e429
OPENCLI_SOURCE_REVISION=fengwk/OpenCLI@0954a2a25682c273ab94a588a8f87f8d012b20a2
EXTENSION_VERSION=1.0.33
OPENCLI_EXTENSION_URL=https://github.com/fengwk/OpenCLI/releases/download/fork-v1.8.7-fengwk.12/opencli-extension-v1.0.33.zip
OPENCLI_EXTENSION_SHA256=f04416a3c4fa77d3a8c26fc50d841f27e113ba88f271fdcde9a8be85b891ef92
