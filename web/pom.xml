<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fun.fengwk.opencli-hub</groupId>
        <artifactId>opencli-hub-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>opencli-hub-web</artifactId>

    <dependencies>
        <dependency>
            <groupId>fun.fengwk.opencli-hub</groupId>
            <artifactId>opencli-hub-core</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.convention4j</groupId>
            <artifactId>convention4j-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- Explicit test-scope H2 driver for the web full-context test profile
             (test-only application-local-h2.yml); never packaged into the boot JAR. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>fun.fengwk.convention4j</groupId>
            <artifactId>convention4j-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- One executable JAR per build variant: opencli-hub-web-1.0.0-{postgresql|mysql|sqlite}.jar -->
        <finalName>opencli-hub-web-${project.version}-${db.variant}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The active profile's datasource config is copied to the classpath root as
                 application-database.yml so application.yml can import a variant-independent name. -->
            <resource>
                <directory>src/main/database/${db.variant}</directory>
                <includes>
                    <include>application-database.yml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!--
                Package the pre-built frontend into the Spring Boot JAR static
                resources. CI/Docker must run `npm ci && npm run build` in
                ../frontend first; Maven only copies the resulting dist and
                never runs npm itself. When ../frontend/dist is absent (e.g.
                backend-only `mvn test`), copy-resources skips the missing
                directory with a warning instead of failing. The dist is copied
                into target/classes/static and is never written back to
                src/main/resources.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../frontend/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
